---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col items-center justify-between border-t pt-6 sm:flex-row-reverse sm:pt-4"
  >
    <Socials />
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span>{t.footer.copyright} &#169; {currentYear}</span>
      <span class="hidden sm:inline">&nbsp;|&nbsp;</span>
      <span>{t.footer.allRightsReserved}</span>
    </div>
  </div>
  {/*
    模板致谢：本站基于 AstroPaper（MIT）二次开发。
    MIT 在法律上只要求保留 LICENSE 里的版权声明（已保留 Sat Naing），
    这里页脚的署名属于对原作者的致谢，不影响合规性。
  */}
  <p class="text-muted-foreground py-4 text-center text-xs">
    Built with
    <a
      href="https://github.com/satnaing/astro-paper"
      target="_blank"
      rel="noopener noreferrer"
      class="hover:text-accent underline"
    >
      AstroPaper
    </a>
  </p>
</footer>
