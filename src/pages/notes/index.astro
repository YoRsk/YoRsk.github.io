---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getNoteUrl } from "@/utils/getNotePaths";
import { getSortedNotes } from "@/utils/getSortedNotes";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const notes = getSortedNotes(await getCollection("notes"));

// 文案取自 i18n（src/i18n/lang/zh-CN.ts 的 pages.notesTitle / pages.notesDesc），
// 内容与旧 Hugo 站 content/notes/_index.md 的 title / summary 一致。
const pageTitle = t.pages.notesTitle;
const pageDesc = t.pages.notesDesc;
---

<Layout title={`${pageTitle} | ${config.site.title}`} description={pageDesc}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={pageTitle} pageDesc={pageDesc}>
    {
      notes.length === 0 ? (
        <p class="italic">这里还没有笔记。</p>
      ) : (
        <ul>
          {notes.map(note => (
            <li class="my-6">
              <a
                href={getNoteUrl(note.id, note.filePath, locale)}
                class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline focus-visible:underline-offset-0"
              >
                {note.data.title}
              </a>
              <Datetime
                pubDatetime={note.data.pubDatetime}
                modDatetime={note.data.modDatetime}
                timezone={note.data.timezone}
              />
              <p>{note.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
